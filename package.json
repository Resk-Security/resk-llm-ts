{
  "name": "resk-llm-ts",
  "version": "2.2.0",
  "description": "Prompt-injection and LLM security toolkit for Node.js and Bun - https://resk.fr",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./protection": {
      "types": "./dist/v2/protection/index.d.ts",
      "import": "./dist/v2/protection/index.js",
      "default": "./dist/v2/protection/index.js"
    },
    "./integrations": {
      "types": "./dist/v2/integrations/index.d.ts",
      "import": "./dist/v2/integrations/index.js",
      "default": "./dist/v2/integrations/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && mkdir -p dist/v2/config && cp src/v2/config/patterns.json dist/v2/config/",
    "build:prod": "bun run build",
    "test": "bun run src/v2/index.test.ts",
    "lint": "tsc --noEmit",
    "docs:build": "typedoc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Resk-Security/resk-llm-ts.git"
  },
  "keywords": [
    "llm",
    "ai",
    "security",
    "openrouter",
    "resk",
    "prompt-injection",
    "bun",
    "typescript"
  ],
  "author": "Resk <contact@resk.fr>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Resk-Security/resk-llm-ts/issues"
  },
  "homepage": "https://github.com/Resk-Security/resk-llm-ts#readme",
  "dependencies": {},
  "peerDependencies": {
    "express": "^4.18.0",
    "hono": "^4.0.0",
    "openai": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^4.17.21",
    "hono": "^4.6.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist/**/*",
    "!dist/**/*.test.*"
  ],
  "overrides": {
    "body-parser": "^1.20.6",
    "form-data": "^4.0.6",
    "qs": "^6.15.4"
  }
}
